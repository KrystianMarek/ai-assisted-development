
# Beads / Dolt files (added by bd init)
# The whole .beads/ tree is per-project state generated by `bd init`
# and contains a project-specific sync.remote URL — regenerate, don't share.
.beads/
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Claude Code per-user local settings (permissions, etc.)
.claude/settings.local.json

# Agent conversation memory (per-machine, not shared)
.remember/

# macOS Finder metadata
.DS_Store

# Agent worktrees — ALL worktrees live under this one ignored root.
# Create with: bd worktree create .worktrees/<name> --branch <name>
# Never add per-worktree or scratch paths to this file (see AGENTS.md → Repository Hygiene).
.worktrees/
